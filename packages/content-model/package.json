{
  "name": "@rm-industries/content-model",
  "version": "1.0.0-rc.1",
  "description": "Typed, integration-neutral content models and adapters for content-driven websites",
  "keywords": [
    "astro",
    "cms",
    "content-model",
    "content-schema",
    "static-site-generator",
    "sveltia",
    "sveltia-cms",
    "typescript"
  ],
  "homepage": "https://github.com/rm-industries/forge/tree/main/packages/content-model#readme",
  "bugs": {
    "url": "https://github.com/rm-industries/forge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rm-industries/forge.git",
    "directory": "packages/content-model"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./sveltia": {
      "types": "./dist/sveltia.d.ts",
      "default": "./dist/sveltia.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@sveltia/cms": ">=0.203.2 <0.204.0",
    "astro": "^7.2.3"
  },
  "peerDependenciesMeta": {
    "@sveltia/cms": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || ^26.0.0",
    "npm": "^10.9.0 || ^11.0.0"
  }
}
