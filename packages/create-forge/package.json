{
  "name": "@rm-industries/create-forge",
  "version": "1.1.1",
  "description": "Scaffold accessible, content-driven Astro websites with Sveltia CMS and production-ready tooling",
  "keywords": [
    "accessibility",
    "astro",
    "cms",
    "content-driven",
    "create-forge",
    "daisyui",
    "github-pages",
    "project-generator",
    "static-site-generator",
    "sveltia",
    "sveltia-cms",
    "tailwindcss",
    "typescript",
    "website-generator"
  ],
  "homepage": "https://github.com/rm-industries/forge/tree/main/packages/create-forge#readme",
  "bugs": {
    "url": "https://github.com/rm-industries/forge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rm-industries/forge.git",
    "directory": "packages/create-forge"
  },
  "bin": {
    "create-forge": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown && node scripts/write-ci-pins.ts && node scripts/copy-template.ts",
    "prepack": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/test-generator-e2e.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify:package": "npm run build && node scripts/verify-package.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "oxfmt": "^0.72.0",
    "validate-npm-package-name": "^8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/validate-npm-package-name": "^4.0.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || ^26.0.0",
    "npm": "^10.9.0 || ^11.0.0"
  }
}
