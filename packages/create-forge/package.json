{
  "name": "@rm-industries/create-forge",
  "version": "1.0.3",
  "description": "Scaffold accessible, content-driven Astro websites with Sveltia CMS and production-ready tooling",
  "keywords": [
    "accessibility",
    "astro",
    "cms",
    "content-driven",
    "create-forge",
    "daisyui",
    "github-pages",
    "project-generator",
    "static-site-generator",
    "sveltia",
    "sveltia-cms",
    "tailwindcss",
    "typescript",
    "website-generator"
  ],
  "homepage": "https://github.com/rm-industries/forge/tree/main/packages/create-forge#readme",
  "bugs": {
    "url": "https://github.com/rm-industries/forge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rm-industries/forge.git",
    "directory": "packages/create-forge"
  },
  "bin": {
    "create-forge": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./ci": {
      "types": "./dist/ci/index.d.ts",
      "import": "./dist/ci/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-template.ts && tsc -p tsconfig.build.json && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('src/ci/github.yml', 'dist/ci/github.yml')\"",
    "prepack": "npm run typecheck && npm test && npm run build",
    "test": "vitest run && npm run test:ci",
    "test:compatibility": "npm run build && node scripts/test-generator-e2e.ts --compatibility",
    "test:e2e": "npm run build && node scripts/test-generator-e2e.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify:package": "npm run build && node scripts/verify-package.ts",
    "test:ci": "node --test src/ci/*.test.ts scripts/ci.test.ts",
    "ci:generate": "node scripts/ci.ts",
    "ci:check": "npm run typecheck && node --test scripts/ci.test.ts && node scripts/ci.ts --check"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "validate-npm-package-name": "^8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/validate-npm-package-name": "^4.0.2",
    "@zuke/core": "npm:@jsr/zuke__core@1.70.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || ^26.0.0",
    "npm": "^10.9.0 || ^11.0.0"
  }
}
