{
  "name": "@rm-industries/markdownlint-frontmatter",
  "version": "0.1.0",
  "description": "Source-preserving YAML frontmatter ordering rule for Markdownlint",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepack": "npm run typecheck && npm test && npm run build",
    "test:packed": "node test/packed.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "markdownlint": "^0.42.0"
  },
  "peerDependencies": {
    "markdownlint": "^0.42.0"
  }
}
