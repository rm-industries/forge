diff --git a/src/integrations/sveltia/formatting.test.ts b/src/integrations/sveltia/formatting.test.ts
new file mode 100644
index 0000000..eb8ad69
--- /dev/null
+++ b/src/integrations/sveltia/formatting.test.ts
@@ -0,0 +1,43 @@
+import { beforeEach, expect, test, vi } from 'vitest';
+
+const { register, format } = vi.hoisted(() => ({ register: vi.fn(), format: vi.fn() }));
+vi.mock('@sveltia/cms', () => ({ registerCustomFormat: register }));
+vi.mock('@rm-industries/browser-oxfmt', () => ({ format }));
+
+import { registerSveltiaFormatting } from './formatting';
+
+beforeEach(() => vi.clearAllMocks());
+
+test('serializes with the native context before sending text to the worker', async () => {
+  registerSveltiaFormatting();
+  const [, , { toFile }] = register.mock.calls[0]!;
+  const data = { title: 'Article', body: '# Body' };
+  const serialize = vi.fn().mockResolvedValue('native text');
+  format.mockResolvedValue('formatted text');
+  await expect(toFile(data, { serialize })).resolves.toBe('formatted text');
+  expect(serialize).toHaveBeenCalledWith(data);
+  expect(format).toHaveBeenCalledWith(
+    'native text',
+    'entry.md',
+    expect.objectContaining({ upstreamVersion: '0.72.0' }),
+  );
+});
+
+test('does not format or save after native serialization fails', async () => {
+  registerSveltiaFormatting();
+  const [, , { toFile }] = register.mock.calls[0]!;
+  const failure = new Error('Native serialization failed');
+  await expect(toFile({}, { serialize: vi.fn().mockRejectedValue(failure) })).rejects.toBe(failure);
+  expect(format).not.toHaveBeenCalled();
+});
+
+test('keeps a recoverable worker error actionable instead of returning native text', async () => {
+  registerSveltiaFormatting();
+  const [, , { toFile }] = register.mock.calls[0]!;
+  const failure = Object.assign(new Error('Missing WASM asset'), { code: 'load' });
+  format.mockRejectedValue(failure);
+  await expect(toFile({}, { serialize: vi.fn().mockResolvedValue('native text') })).rejects.toMatchObject({
+    cause: failure,
+    message: expect.stringContaining('Formatting failed (load): Missing WASM asset'),
+  });
+});
diff --git a/src/integrations/sveltia/formatting.ts b/src/integrations/sveltia/formatting.ts
new file mode 100644
index 0000000..9eeda70
--- /dev/null
+++ b/src/integrations/sveltia/formatting.ts
@@ -0,0 +1,21 @@
+import { format, type BrowserOxfmtError, type ResolvedOptions } from '@rm-industries/browser-oxfmt';
+import { registerCustomFormat } from '@sveltia/cms';
+
+declare const __BROWSER_OXFMT_OPTIONS__: ResolvedOptions;
+
+export const registerSveltiaFormatting = () => {
+  registerCustomFormat('frontmatter', 'md', {
+    toFile: async (data, { serialize }) => {
+      const native = await serialize(data);
+      try {
+        return await format(native, 'entry.md', __BROWSER_OXFMT_OPTIONS__);
+      } catch (error) {
+        const failure = error as BrowserOxfmtError;
+        throw new Error(
+          `Formatting failed (${failure.code}): ${failure.message}. Your edits remain open; fix the error and retry.`,
+          { cause: error },
+        );
+      }
+    },
+  });
+};
