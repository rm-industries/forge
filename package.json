{
  "name": "@rm-industries/forge-root",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Forge, a generator for accessible, content-driven Astro websites",
  "keywords": [
    "astro",
    "content-model",
    "forge",
    "monorepo",
    "site-generator"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "audit": "audit-ci --config audit-ci.jsonc",
    "docs:check": "npm run format && npm run lint:markdown && npm run spellcheck && npm run docs:validate",
    "docs:links:external": "node scripts/validate-documentation.ts --external",
    "docs:validate": "node scripts/validate-documentation.ts",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "npm run lint:repo",
    "lint:code": "oxlint",
    "lint:code:fix": "oxlint --fix",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint:repo": "npm run lint:code && npm run lint:markdown && npm run spellcheck && npm run docs:validate",
    "spellcheck": "cspell \"**\"",
    "typecheck": "npm run typecheck:root && npm run typecheck:workspaces",
    "typecheck:root": "tsc --noEmit && tsc --project tsconfig.verification.json --noEmit",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:root && npm run test:workspaces",
    "test:generator:e2e": "npm run test:e2e --workspace @rm-industries/create-forge",
    "test:root": "vitest run --config scripts/vitest.config.ts",
    "test:workspaces": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "pack": "npm pack --dry-run --workspaces",
    "peer:prepare": "node scripts/prepare-peer-upgrade.ts",
    "release:prepare": "node scripts/prepare-package-release.ts",
    "template:sync": "node scripts/prepare-template-sync.ts",
    "website:build": "npm run build --prefix website",
    "website:lighthouse": "npm run lighthouse:ci --prefix website",
    "website:quality": "npm run quality --prefix website",
    "website:quality:static": "npm run quality:static:ci --prefix website",
    "website:test:browser": "npm run test:e2e --prefix website",
    "website:test:coverage": "npm run test:coverage --prefix website",
    "quality": "npm run quality:native --workspace @rm-industries/browser-oxfmt && npm run format && npm run lint && npm run typecheck && npm test && npm run build && npm run pack",
    "verify:template": "node scripts/verify-template.ts",
    "test:frontmatter:cms": "npm run build --workspace @rm-industries/content-model && npm run build --workspace @rm-industries/markdownlint-frontmatter && node scripts/verify-frontmatter-cms.ts",
    "test:contracts": "vitest run --config scripts/vitest.config.ts --exclude scripts/verify-frontmatter-model.test.ts",
    "test:integration": "vitest run --config scripts/vitest.config.ts scripts/verify-frontmatter-model.test.ts",
    "test:template:customization": "node scripts/test-template.ts customization"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltia/cms": "^0.251.0",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "astro": "^7.3.8",
    "audit-ci": "7.1.0",
    "cspell": "^10.4.0",
    "markdownlint": "0.42.0",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.74.0",
    "oxlint": "^1.88.0",
    "playwright-core": "1.64.1",
    "semver": "^7.8.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || ^26.0.0",
    "npm": "^10.9.0 || ^11.0.0"
  },
  "packageManager": "npm@11.19.0"
}
