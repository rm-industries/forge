{
  "name": "@rm-industries/forge-root",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "npm run lint:repo",
    "lint:code": "oxlint",
    "lint:code:fix": "oxlint --fix",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore-path .gitignore",
    "lint:markdown:fix": "markdownlint --fix \"**/*.md\" --ignore-path .gitignore",
    "lint:repo": "npm run lint:code && npm run lint:markdown && npm run spellcheck",
    "spellcheck": "cspell \"**\"",
    "typecheck": "npm run typecheck:root && npm run typecheck:workspaces",
    "typecheck:root": "tsc --noEmit",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:root && npm run test:workspaces",
    "test:generator:e2e": "npm run test:e2e --workspace @rm-industries/create-forge",
    "test:root": "vitest run --config scripts/vitest.config.ts",
    "test:workspaces": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "pack": "npm pack --dry-run --workspaces",
    "peer:prepare": "node scripts/prepare-peer-upgrade.ts",
    "release:prepare": "node scripts/prepare-package-release.ts",
    "quality": "npm run format && npm run lint && npm run typecheck && npm test && npm run build && npm run pack",
    "verify:template": "node scripts/verify-template.ts",
    "verify:template:static": "node scripts/verify-template-static-quality.ts"
  },
  "devDependencies": {
    "@sveltia/cms": "^0.193.2",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "astro": "^7.2.4",
    "cspell": "^10.0.1",
    "markdownlint-cli": "^0.49.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.72.0",
    "semver": "^7.8.5",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || ^26.0.0",
    "npm": "^10.9.0 || ^11.0.0"
  },
  "packageManager": "npm@11.19.0"
}
