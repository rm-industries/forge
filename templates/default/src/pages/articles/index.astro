---
import Card from '../../components/ui/Card.astro';
import Container from '../../components/ui/Container.astro';
import { getArticles } from '../../data/articles';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = getArticles({ includeDrafts: import.meta.env.DEV });
---

<BaseLayout title="Articles" description="Generic example articles that demonstrate Forge content routes and metadata.">
  <Container class="space-y-10 pb-16">
    <header class="max-w-2xl space-y-3">
      <div class="badge badge-outline">Example content</div>
      <h1 class="text-4xl font-bold">Articles</h1>
      <p>Replace these generic entries with your own subject matter when you connect the site to its content model.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        articles.map((article) => (
          <Card href={`/articles/${article.slug}/`} size="lg">
            <time datetime={article.publishedAt}>{new Date(`${article.publishedAt}T00:00:00Z`).toLocaleDateString('en', { dateStyle: 'long', timeZone: 'UTC' })}</time>
            <h2 class="card-title">{article.title}</h2>
            <p>{article.description}</p>
            {article.draft && <div class="badge badge-warning">Draft preview</div>}
          </Card>
        ))
      }
    </div>
  </Container>
</BaseLayout>
