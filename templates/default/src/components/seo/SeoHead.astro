---
import { site } from '../../config/site';
import { resolveSiteHref } from '../../lib/paths';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'article' | 'website';
  publishedTime?: string;
}

const {
  title,
  description = site.description,
  canonicalPath,
  type = 'website',
  publishedTime,
} = Astro.props;

const publicSite = Astro.site;
if (!publicSite) throw new Error('Canonical metadata requires Astro site configuration.');
// Request paths are mounted; explicit canonical overrides are logical site routes.
const canonicalUrl = new URL(
  canonicalPath === undefined
    ? Astro.url.pathname
    : resolveSiteHref(`/${canonicalPath.replace(/^\/+/, '')}`),
  publicSite,
);
if (canonicalPath !== undefined) {
  canonicalUrl.pathname = `${canonicalUrl.pathname.replace(/\/{2,}/g, '/').replace(/\/$/, '')}/`;
}
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const socialImageUrl = new URL(typeof site.socialImage === 'string' ? resolveSiteHref(site.socialImage) : site.socialImage.src, publicSite);
---

<title>{pageTitle}</title>
<meta name="generator" content="Forge by RM Industries" />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href={resolveSiteHref('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} RSS feed`} href={resolveSiteHref('/rss.xml')} />
<link rel="icon" href={resolveSiteHref('/favicon.svg')} type="image/svg+xml" />
<link rel="manifest" href={resolveSiteHref('/site.webmanifest')} />

<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:image" content={socialImageUrl} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />
