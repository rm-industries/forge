---
import Card from '../components/ui/Card.astro';
import Container from '../components/ui/Container.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentation as publications } from '../config/documentation';
import { getCollection } from 'astro:content';
import { documentationHref, documentationPublication, documentationTitle } from '../lib/documentation';

const entries = await getCollection('documentation');
const documents = publications.map(({ id }) => entries.find((entry) => entry.id === id)!);
const groups = Map.groupBy(documents, (entry) => documentationPublication(entry.id).section);
---

<BaseLayout title="Documentation" description="Learn to create, customize, deploy, and maintain a Forge site.">
  <Container class="space-y-10 pb-16">
    <PageIntro eyebrow="Documentation" title="Build your first Forge site.">
      <p>Start with the tutorial, then follow the guides in reading order. Each page comes from its canonical repository source.</p>
    </PageIntro>
    {Array.from(groups).map(([group, entries]) => <section class="space-y-5"><h2 class="font-mono text-sm font-medium tracking-[0.12em] text-primary uppercase">{group}</h2><div class="grid gap-4 md:grid-cols-2">{entries.map((entry) => <Card href={documentationHref(entry.id)}><h3 class="card-title text-2xl">{documentationTitle(entry)}</h3></Card>)}</div></section>)}
  </Container>
</BaseLayout>
