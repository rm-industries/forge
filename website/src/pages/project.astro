---
import Card from '../components/ui/Card.astro';
import Container from '../components/ui/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Project" description="Find Forge releases, roadmap, contribution, support, security, and licensing information.">
  <Container class="space-y-10 pb-16">
    <header class="max-w-2xl space-y-3"><div class="badge badge-outline">Open source</div><h1 class="text-4xl font-bold">Build and improve Forge with RM Industries.</h1><p>Development, planning, support, and releases are public on GitHub. Security reports use a separate private channel.</p></header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <Card href="https://github.com/rm-industries/forge/releases"><h2 class="card-title">Releases</h2><p>Review package and project checkpoint history.</p></Card>
      <Card href="https://github.com/orgs/rm-industries/projects/3"><h2 class="card-title">Roadmap</h2><p>Follow planned milestones and current work.</p></Card>
      <Card href="https://github.com/rm-industries/forge/issues"><h2 class="card-title">Issues and support</h2><p>Report reproducible defects or propose focused improvements.</p></Card>
      <Card href="https://github.com/rm-industries/forge/blob/main/CONTRIBUTING.md"><h2 class="card-title">Contributing</h2><p>Prepare a change and run the expected validation.</p></Card>
      <Card href="https://github.com/rm-industries/forge/security/policy"><h2 class="card-title">Security</h2><p>Report vulnerabilities privately and review the disclosure policy.</p></Card>
      <Card href="https://github.com/rm-industries/forge/blob/main/LICENSE"><h2 class="card-title">MIT license</h2><p>Use, modify, and distribute Forge under its open-source license.</p></Card>
    </div>
  </Container>
</BaseLayout>
