---
import type { SiteLink } from '../../config/site';
import { isCurrentPath } from '../../lib/navigation';
import { resolveSiteHref } from '../../lib/paths';

interface Props {
  brand: string;
  brandHref?: string;
  links: readonly SiteLink[];
  currentPath: string;
}

const { brand, brandHref = '/', links, currentPath } = Astro.props;
const resolvedBrandHref = resolveSiteHref(brandHref);
---

<div class="navbar min-h-0 p-0">
  <div class="navbar-start">
    <a href={resolvedBrandHref} class="group flex items-center gap-3 font-semibold" aria-label={`${brand} home`}>
      <span class="grid size-9 place-items-center rounded-sm border border-primary font-mono text-sm font-bold text-primary transition-colors group-hover:bg-primary group-hover:text-primary-content">FG</span>
      <span>{brand}</span>
    </a>
  </div>

  <nav class="navbar-end hidden sm:flex" aria-label="Primary navigation">
    <ul class="menu menu-horizontal gap-1 p-0" role="list">
      {
        links.map((item) => {
          const href = resolveSiteHref(item.href);
          const isCurrent = isCurrentPath(currentPath, href);

          return (
            <li>
              <a {href} aria-current={isCurrent ? 'page' : undefined} class:list={['rounded-sm', isCurrent && 'menu-active']}>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="navbar-end sm:hidden">
    <details class="dropdown dropdown-end">
      <summary class="btn btn-ghost rounded-sm">Menu</summary>
      <nav class="dropdown-content z-10 mt-3 w-52 rounded-box bg-base-200 p-2 shadow" aria-label="Mobile navigation">
        <ul class="menu" role="list">
          {
            links.map((item) => {
              const href = resolveSiteHref(item.href);
              const isCurrent = isCurrentPath(currentPath, href);

              return (
                <li>
                  <a {href} aria-current={isCurrent ? 'page' : undefined} class:list={[isCurrent && 'menu-active']}>
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </details>
  </div>
</div>
