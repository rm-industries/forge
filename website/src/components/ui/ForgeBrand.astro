---
import forgeLogo from '../../../../docs/assets/forge-logo.svg';

interface Props {
  href: string;
  name: string;
}

const { href, name } = Astro.props;
---

<a {href} class="group flex items-center gap-3 font-semibold" aria-label={`${name} home`}>
  <img src={forgeLogo.src} width="40" height="40" alt="" class="size-10 transition-transform group-hover:-rotate-3" />
  <span>{name}</span>
</a>
