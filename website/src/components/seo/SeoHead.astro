---
import { site } from '../../config/site';
import { resolveSiteHref } from '../../lib/paths';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = site.description, canonicalPath } = Astro.props;
if (!Astro.site) throw new Error('Canonical metadata requires Astro site to identify the public deployment.');

const canonicalUrl = canonicalPath === undefined && !import.meta.env.DEV
  ? new URL(Astro.url.pathname, Astro.site).href
  : (() => {
      // Local routes start at / while their public identity remains under /forge/.
      const path = `/${canonicalPath ?? Astro.url.pathname}`.replace(/\/{2,}/g, '/');
      return new URL(path === '/' ? '' : `${path.replace(/\/$/, '').slice(1)}/`, Astro.site).href;
    })();
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const socialImageUrl = new URL(
  typeof site.socialImage === 'string' ? site.socialImage.replace(/^\//, '') : site.socialImage.src,
  Astro.site,
).href;
---

<title>{pageTitle}</title>
<meta name="generator" content="Forge by RM Industries" />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href={resolveSiteHref('/sitemap-index.xml')} />
<link rel="icon" href={resolveSiteHref('/favicon.svg')} type="image/svg+xml" />
<link rel="manifest" href={resolveSiteHref('/site.webmanifest')} />

<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content="website" />
<meta property="og:image" content={socialImageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />
